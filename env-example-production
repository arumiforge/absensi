#--------------------------------------------------------------------
# Spensada — production environment for https://spensada.web.id
#
# Ready to copy: nothing in this file needs editing on a Laragon server
# (MySQL user root without a password, database `absensi`).
#
# Setup in the Laragon terminal, in the project folder:
#   copy env-example-production .env
#   php spark key:generate
#   php spark migrate
#   php spark data:contoh            (optional: 200 sample students to try the app)
#   php spark admin:password         (skip if data:contoh already made the admin)
#
# The repository is public, so the encryption key is left empty here;
# `php spark key:generate` writes a new one into `.env`.
# Before real use: php spark data:contoh --kosongkan
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# HTTPS only: the camera and the login cookies need it.
app.baseURL = 'https://spensada.web.id/'
app.forceGlobalSecureRequests = true

# The app sends its own Content-Security-Policy (App\Filters\Keamanan).
# true would add a second, stricter policy that blocks Bootstrap's icons.
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# Laragon default MySQL account: root without a password.
database.default.hostname = localhost
database.default.database = absensi
database.default.username = root
database.default.password =
database.default.DBDriver = App\Database\MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

encryption.key =

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# Warnings and errors only.
logger.threshold = 5
